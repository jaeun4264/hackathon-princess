ame": null, "sourceDetail": null, "party": null}, {"id": "s14", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s15", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s16", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s17", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s18", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s19", "text": null, "type": "quote", "sourceType": "etc", "sourceName": "한 전 총리 측", "sourceDetail": "익명(소속 미상)", "party": null}, {"id": "s20", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s21", "text": "대법원도 한 전 총리의 행위를 내란 중요임무로 볼 수 있는지가 관건이다.", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s22", "text": "이는 이상민 전 장관과 박성재 전 법무부 장관 등 다른 국무위원들 재판의…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s23", "text": "대법원이 오는 19일을 선고기일로 정한 배경에도 관심이 모인다.", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s24", "text": null, "type": "quote", "sourceType": "etc", "sourceName": "대법원", "sourceDetail": "대법원", "party": null}, {"id": "s25", "text": null, "type": "fact", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s26", "text": "한 전 총리의 구속기간은 오는 20일 만료되는데, 통상 전합이 당일 합의…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s27", "text": "여권을 중심으로 대법원이 심리를 고의로 지연해 한 전 총리를 풀어주려는…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s28", "text": "특히 대법원이 지난해 이재명 당시 대통령 후보의 공직선거법 사건을 전원합…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s29", "text": "이런 상황에서 대법원이 이날 선고기일을 19일로 잡았다고 공지하자, 심리…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s30", "text": "반대로 전합이 결론을 냈는지도 불분명한 상황에서 구속 만료에 맞춰 선고…", "type": "opinion", "sourceType": null, "sourceName": null, "sourceDetail": null, "party": null}, {"id": "s31", "text": null, "type": "quote", "sourceType": "etc", "sourceName": "대법원", "sourceDetail": "대법원", "party": null}, {"id": "s32", "text": null, "type": "quote", "sourceType": "etc", "sourceName": "대법원", "sourceDetail": "대법원", "party": null}], "framingTerms": [{"term": "주목된다", "sentenceId": "s3"}, {"term": "관건이다", "sentenceId": "s21"}, {"term": "보인다", "sentenceId": "s22"}, {"term": "관심이 모인다", "sentenceId": "s23"}, {"term": "예상됐다", "sentenceId": "s26"}, {"term": "지적", "sentenceId": "s27"}, {"term": "비판", "sentenceId": "s28"}, {"term": "지적", "sentenceId": "s29"}, {"term": "지적", "sentenceId": "s30"}], "analyzedBy": "gemini-3.5-flash-lite"}