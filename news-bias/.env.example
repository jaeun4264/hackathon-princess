   # 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 값을 넣으세요.
   # .env 는 .gitignore 에 있어서 GitHub에 올라가지 않습니다.

   # 기사 수집: NAVER API HUB → Application → [인증 정보]
   NAVER_CLIENT_ID=
   NAVER_CLIENT_SECRET=

   # AI 분석 (app/analyze.py) — 제공사마다 키를 따로 넣고, 실행할 때 --모델 로 고름
   # Gemini: Google AI Studio → Get API key
   GEMINI_API_KEY=
   GEMINI_MODEL=gemini-3.8-flash
   # Claude: console.anthropic.com → API Keys
   ANTHROPIC_API_KEY=
   ANTHROPIC_MODEL=claude-sonnet-5-5
   # Groq (무료, 공개 모델): console.groq.com → API Keys, 모델 이름은 Models 목록에서
   GROQ_API_KEY=
   GROQ_MODEL=
   # --모델 을 안 적었을 때 쓸 제공사
   LLM_PROVIDER=gemini
